# ==========================================
# Pet Research Navigator - 환경 변수 설정 안내
# ==========================================

# 1. AI 모델 설정 (Google Gemini 기본 지원)
# AI 프로바이더 선택: auto (키가 있는 것을 자동 선택), gemini, 또는 openai
AI_PROVIDER=gemini

# Google AI Studio (https://aistudio.google.com/)에서 무료 발급받은 Gemini API 키
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.6-flash

# (선택 사항) OpenAI API 키를 사용하고 싶을 경우
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# 2. Firebase Firestore 설정
# 옵션 A: 서비스 계정 키 JSON 파일 경로 (로컬 개발 시)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase_service_account.json

# 옵션 B: 서비스 계정 키 JSON 문자열 전체 (Render 등 클라우드 배포 시)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# 3. 데이터 저장소 모드 (선택 사항)
# auto: Firebase 키가 있으면 Firestore 사용, 없으면 스마트 로컬 저장소로 자동 폴백
# local: 항상 로컬 저장소 사용
# firestore: 항상 Firestore 사용
DATA_STORE_MODE=auto

# 4. 서버 및 CORS 설정
PORT=8000
ALLOWED_ORIGINS=*
